# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# Twilio credentials (required for WhatsApp notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp numbers (include the "whatsapp:" prefix)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP_TO=whatsapp:+1234567890

# Publicly reachable base URL of this server
APP_BASE_URL=https://your-server.example.com

# Scheduler tuning (all values in minutes)
CHECK_INTERVAL_MINUTES=10
REMINDER_INTERVAL_MINUTES=5
REMINDER_RESEND_MINUTES=30

# HTTP request timeout in seconds
MONITOR_TIMEOUT=15

# Flask server settings
FLASK_PORT=5000
FLASK_DEBUG=false
